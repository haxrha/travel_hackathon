# =============================================================================
# .env.example — copy into .env.local (the file Next.js reads).
#
# For localhost demo: leave Clerk as placeholders. App runs in DEMO MODE with
# mock travel data — no API keys required to view the UI.
# =============================================================================

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database — optional in demo mode
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth (Clerk) — placeholders keep DEMO MODE on
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_cGxlYXNpbmctZWZ0LTU0LmNsZXJrLmFjY291bnRzLmRldiQ"
CLERK_SECRET_KEY="sk_test_7pbDyLt2VyPgITI1UsKDyVHP30vSGEl7zovhoxdBA8"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app"

# LLMs — optional (planner has offline skeleton)
# Google AI Studio / Gemini — uses gemini-3.1-flash-lite (cheap free tier)
GOOGLE_GENERATIVE_AI_API_KEY=""

TAVILY_API_KEY="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"
STAY22_API_KEY="stay22_01218b50-d4f2-4dca-8802-068c24abefda"
STAY22_AID=""
# Flights. Without these, every fare is SIMULATED and badged as such in the UI.
# Defaults to the production host (api.amadeus.com). Set AMADEUS_ENV="test" to
# use the sandbox — note it serves a fixed cache, so prices are NOT real.
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="production"
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
# Optional — defaults to Rachel voice for TTS outcome demo
ELEVENLABS_VOICE_ID=""
MAPBOX_ACCESS_TOKEN="pk.eyJ1IjoiYXJ5YW5hY2hhcnlhIiwiYSI6ImNtc2Zka2MxZTBhcWgyeG9jdjNrdHJyNzcifQ.dLlLC0FMGoRmGpDEfMZhg"
MAPBOX_ACCESS_TOKEN=""
# Browser map tiles — MUST be a public token starting with pk. (not sk.)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
OPENWEATHER_API_KEY=""
VIATOR_API_KEY=""
ROVE_API_KEY=""
EXCHANGE_RATE_API_KEY=""

# Backboard — cross-trip traveler memory (https://docs.backboard.io)
# One assistant per user. Planning turns send memory: "Auto".
# Pin BACKBOARD_ASSISTANT_ID after the first run if you have no database,
# so a restart keeps the same assistant.
BACKBOARD_API_KEY=""
# BACKBOARD_ASSISTANT_ID=""
# BACKBOARD_BASE_URL="https://app.backboard.io/api"
# BACKBOARD_LLM_PROVIDER="openai"
# BACKBOARD_MODEL_NAME="gpt-4o"

# Stripe — booking charges. Test keys (sk_test_) confirm with pm_card_visa.
# Live keys (sk_live_) open Checkout unless STRIPE_PAYMENT_METHOD_ID is set.
# Webhook endpoint: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# STRIPE_PAYMENT_METHOD_ID=""
# STRIPE_API_VERSION="2024-11-20.acacia"

# Firebase web client (from Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

