# Stripe — booking charges for the Python agent and the Next.js app
# (the Next.js server also reads this file if the var is missing from .env.local).
# Test keys (sk_test_) confirm with Stripe's test card. Live keys open Checkout
# unless STRIPE_PAYMENT_METHOD_ID is set.
STRIPE_SECRET_KEY=""
# STRIPE_PAYMENT_METHOD_ID=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Tavily search for flight/hotel research sub-agents
TAVILY_API_KEY=""

# Gemini for travel/booking agents (any one of these names works)
GOOGLE_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_API_KEY=""
